{
  "type": "record",
  "name": "NestedDecimalEvent",
  "namespace": "event.avro",
  "fields": [
    {"name": "id", "type": "string"},
    {
      "name": "pricing",
      "type": {
        "type": "record",
        "name": "Pricing",
        "fields": [
          {"name": "amount", "type": {"type": "bytes", "logicalType": "decimal", "precision": 12, "scale": 2}},
          {"name": "optionalAmount", "type": ["null", {"type": "bytes", "logicalType": "decimal", "precision": 14, "scale": 4}], "default": null},
          {"name": "amounts", "type": {"type": "array", "items": {"type": "bytes", "logicalType": "decimal", "precision": 12, "scale": 2}}}
        ]
      }
    }
  ]
}
